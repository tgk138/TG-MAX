# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/tgmax

# Redis (broker only)
REDIS_URL=redis://redis:6379/0

# Encryption key for secrets.py (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SECRET_KEY=1111
SESSION_COOKIE_NAME=session_key
SESSION_TTL_DAYS=30
SESSION_COOKIE_SECURE=false

# Telegram API credentials (https://my.telegram.org)
TELEGRAM_API_ID=11
TELEGRAM_API_HASH=1111
# Optional: device profile (can help with in-app code delivery)
# TELEGRAM_DEVICE_MODEL=Desktop
# TELEGRAM_SYSTEM_VERSION=10
# TELEGRAM_APP_VERSION=4.16.0
# TELEGRAM_LANG_CODE=en
# TELEGRAM_SYSTEM_LANG_CODE=en-US

# Media storage
MEDIA_ROOT=/data/media

# MAX API
MAX_API_BASE=https://platform-api.max.ru
MAX_ATTACHMENTS_PER_MESSAGE=10

# Rate limits
PUBLISH_DELAY_MS_MIN=300
PUBLISH_DELAY_MS_MAX=800
UPLOAD_RETRY=5
SEND_RETRY=5
TG_IMPORT_BATCH_SIZE=100
TG_IMPORT_DELAY_MS=500
IMPORT_STALE_TTL_MINUTES=60
IMPORT_STALE_CHECK_SECONDS=120

# Worker
WORKER_CONCURRENCY=2
IMPORT_WORKER_CONCURRENCY=4
PUBLISH_WORKER_CONCURRENCY=2
